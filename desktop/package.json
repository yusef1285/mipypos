{
  "name": "mipypos-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MipyPOS para Windows: punto de venta y servidor local para los teléfonos",
  "author": "MipyPOS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mipypos.desktop",
    "productName": "MipyPOS",
    "copyright": "MipyPOS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lan-identity.cjs",
      "lan-server.cjs",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "MipyPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MipyPOS",
      "include": "build/installer.nsh",
      "language": "3082"
    }
  },
  "productName": "MipyPOS"
}
